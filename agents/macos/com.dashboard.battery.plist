<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dashboard.battery</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <!-- Replace with absolute path to report_battery.sh -->
        <string>/Users/YOUR_USERNAME/DashBoard/agents/macos/report_battery.sh</string>
        <!-- Replace with your dashboard host URL (e.g. http://192.168.1.50:8080 or domain) -->
        <string>http://localhost:8080</string>
        <string>macbook-pro</string>
    </array>
    <!-- Run every 300 seconds (5 minutes) -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/dashboard_battery.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/dashboard_battery.err</string>
</dict>
</plist>
