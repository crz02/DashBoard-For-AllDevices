# ==========================================================================
# Statuser — Configuration
# ==========================================================================

# Server Port (default: 8080)
PORT=8080

# --------------------------------------------------------------------------
# API Key Authentication for /api/report  (OPTIONAL but RECOMMENDED)
# --------------------------------------------------------------------------
# Set this to a long random string to protect your telemetry endpoint.
# Without this, anyone who can reach your server URL can POST fake data.
#
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
#
# Once set, all device agents must send:
#   Authorization: Bearer <your-key>
# or
#   X-Api-Key: <your-key>
#
# Leave blank to disable auth (open access — fine for local-only use).

REPORT_API_KEY=

# --------------------------------------------------------------------------
# Authentication (OPTIONAL — Clerk-based sign in)
# --------------------------------------------------------------------------
# Statuser works fully without authentication. If you want user sign-in,
# set up a free Clerk account at https://dashboard.clerk.com, create an
# application, go to "API Keys", and paste your keys below.
#
# Without these keys, the dashboard runs in single-user mode (no sign-in).

CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
